# KMRL Document Intelligence - backend configuration
# Copy this file to backend/.env and fill in your values.

# Anthropic API key. When set, document analysis and (later) Q&A are powered by Claude.
# When empty, the app automatically falls back to the built-in rule-based analyser,
# so the whole product still works end-to-end without a key.
ANTHROPIC_API_KEY=

# Claude model used for document analysis
KMRL_ANALYSIS_MODEL=claude-opus-5

# Storage
KMRL_DATA_DIR=./data
KMRL_DATABASE_URL=

# Upload limits
KMRL_MAX_UPLOAD_MB=40

# OCR
KMRL_OCR_ENABLED=true
KMRL_OCR_LANGUAGES=eng+mal
KMRL_OCR_MAX_PAGES=25
